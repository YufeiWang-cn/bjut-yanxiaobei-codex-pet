<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BJUT 燕小北 · Codex 助手" Width="344" Height="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed" TextOptions.TextRenderingMode="Auto">
  <Window.Resources>
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF142435" Offset="0"/>
      <GradientStop Color="#FF192C40" Offset="0.58"/>
      <GradientStop Color="#FF111C2A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextBrush" Color="#FFF7F9FC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FFABB5C3"/>
    <Style x:Key="TaskStatText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#FFD0DAE6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="None"/>
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="#FFC3CBD5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBg" CornerRadius="7" Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                SnapsToDevicePixels="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBg" Property="Background" Value="#28FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5"/>
    </Style>
    <Style x:Key="TaskButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Width" Value="Auto"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RowBackground" CornerRadius="9" Background="#1AFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="8,0,6,0">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#304DC1DD"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowBackground" Property="BorderBrush" Value="#FF62D6F1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootSurface" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="180"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Border x:Name="QuotaBubble" Margin="88,6,6,10" CornerRadius="17" Background="{StaticResource PanelBrush}"
              BorderBrush="#42FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid Margin="11,7,7,7">
          <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto" MinHeight="24"/>
          </Grid.RowDefinitions>

          <Grid x:Name="HeaderDragArea" Grid.Row="0" Background="Transparent" Cursor="SizeAll">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#FF7AE0BD" Margin="0,0,6,0"/>
              <TextBlock Text="燕小北" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="Bold"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="StateLabel" Text=" · 空闲中" Foreground="#FFA1E8CC" FontSize="10" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="RefreshButton" Style="{StaticResource ChromeButton}" Content="↻" ToolTip="立即刷新"/>
              <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Content="×" FontSize="15" ToolTip="隐藏额度气泡（右键桌宠可恢复）"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <Grid x:Name="TaskSummary" MinHeight="22" ToolTip="等待任务数据…">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TaskTotalCell" Grid.Column="0" Style="{StaticResource TaskStatText}"><Run Text="任务 "/><Run x:Name="TaskTotalValue" Text="--" FontWeight="SemiBold" Foreground="#FFF7F9FC"/></TextBlock>
              <TextBlock x:Name="TaskRunningCell" Grid.Column="1" Style="{StaticResource TaskStatText}"><Run Text="进行 "/><Run x:Name="TaskRunningValue" Text="--" FontWeight="SemiBold" Foreground="#FFA8EDF5"/></TextBlock>
              <TextBlock x:Name="TaskWaitingCell" Grid.Column="2" Style="{StaticResource TaskStatText}"><Run Text="等待 "/><Run x:Name="TaskWaitingValue" Text="--" FontWeight="SemiBold" Foreground="#FFFFDA80"/></TextBlock>
              <TextBlock x:Name="TaskReadyCell" Grid.Column="3" Style="{StaticResource TaskStatText}"><Run Text="完成 "/><Run x:Name="TaskReadyValue" Text="--" FontWeight="SemiBold" Foreground="#FFC4BCFF"/></TextBlock>
            </Grid>
            <Button x:Name="TaskToggleButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="▾"
                    HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="展开任务活动"/>
          </Grid>

          <Grid Grid.Row="2" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="29"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="25" Height="23" CornerRadius="8" Background="#3019B9D5" HorizontalAlignment="Left">
              <TextBlock Text="5H" Foreground="#FFA8EDF5" FontSize="9" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Grid Grid.Column="1">
              <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="20"/><RowDefinition Height="7"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="FiveHourValue" Text="--% 剩余" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock x:Name="FiveHourReset" Grid.Column="1" Text="等待数据" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <Border Grid.Row="1" Grid.ColumnSpan="2" Height="5" CornerRadius="3" Background="#FF343D4B" VerticalAlignment="Bottom">
                <Border x:Name="FiveHourBar" Width="0" CornerRadius="3" Background="#FF19B9D5" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Grid>

          <Grid Grid.Row="3" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="29"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="25" Height="23" CornerRadius="8" Background="#2860D9C7" HorizontalAlignment="Left">
              <TextBlock Text="7D" Foreground="#FFA9EEE3" FontSize="9" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Grid Grid.Column="1">
              <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="20"/><RowDefinition Height="7"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="WeeklyValue" Text="--% 剩余" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock x:Name="WeeklyReset" Grid.Column="1" Text="等待数据" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <Border Grid.Row="1" Grid.ColumnSpan="2" Height="5" CornerRadius="3" Background="#FF343D4B" VerticalAlignment="Bottom">
                <Border x:Name="WeeklyBar" Width="0" CornerRadius="3" Background="#FF60D9C7" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
          </Grid>

          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="等待额度数据…" Foreground="{StaticResource MutedBrush}" FontSize="10"
                       VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="56" MinHeight="22"
                    CornerRadius="7" Background="#24FFD166" Padding="5,1" SnapsToDevicePixels="True">
              <TextBlock x:Name="ResetCreditValue" Text="重置 --" Foreground="#FFFFD166" FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Image x:Name="PetImage" Width="118" Height="128" HorizontalAlignment="Left" VerticalAlignment="Bottom"
             Stretch="Uniform" Cursor="SizeAll" RenderOptions.BitmapScalingMode="HighQuality"
             ToolTip="双击打开 Codex · 右键显示菜单 · 拖动可移动"/>
      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,5" Padding="8,2"
              CornerRadius="9" Background="#FF142434" BorderBrush="#38FFFFFF" BorderThickness="1" IsHitTestVisible="False">
        <TextBlock x:Name="PetCaption" Text="空闲中" Foreground="#FFF5F8FC" FontSize="10" FontWeight="SemiBold"/>
      </Border>
    </Grid>

    <Border x:Name="TaskTray" Grid.Row="1" Height="158" Margin="64,0,6,6" Visibility="Collapsed"
            CornerRadius="15" Background="{StaticResource PanelBrush}" BorderBrush="#42FFFFFF" BorderThickness="1"
            SnapsToDevicePixels="True">
      <Grid Margin="11,7,7,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="25"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="任务活动" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="Bold"/>
            <Border Margin="7,0,0,0" Padding="6,1" CornerRadius="7" Background="#22FFFFFF">
              <TextBlock x:Name="TaskTrayCount" Text="0 项" Foreground="{StaticResource MutedBrush}" FontSize="9"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ClearReadyButton" Style="{StaticResource ChromeButton}" Content="✓" ToolTip="清除完成和错误提醒"/>
            <Button x:Name="TaskTrayCollapseButton" Style="{StaticResource ChromeButton}" Content="▴" ToolTip="收起任务活动"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#20FFFFFF"/>
        <Grid Grid.Row="2" Margin="0,7,0,0">
          <TextBlock x:Name="TaskTrayEmpty" Text="暂时没有活动任务" Foreground="{StaticResource MutedBrush}"
                     FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TaskListPanel"/>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
